  <address-group-list>
    <address-group><name>EVODE.1</name><addr-group-member><member><type>1</type><host-ip-addr>198.51.100.10</host-ip-addr></member></addr-group-member></address-group>
    <address-group><name>VIP-FTP.1.snat</name><addr-group-member><member><type>1</type><host-ip-addr>192.168.1.20</host-ip-addr></member></addr-group-member></address-group>
  </address-group-list>
  <alias-list>
    <alias><name>Any-External</name><alias-member-list><alias-member><interface>OPERATEUR</interface></alias-member></alias-member-list></alias>
    <alias><name>Any-Trusted</name><alias-member-list><alias-member><interface>LAN</interface></alias-member><alias-member><interface>vlan-invite</interface></alias-member><alias-member><interface>VOIP</interface></alias-member></alias-member-list></alias>
    <alias><name>EVODE</name><alias-member-list><alias-member><alias-name>EVODE-HOSTS</alias-name><interface>Any</interface></alias-member></alias-member-list></alias>
    <alias><name>EVODE-HOSTS</name><alias-member-list><alias-member><address>EVODE.1</address><interface>Any</interface></alias-member></alias-member-list></alias>
    <alias><name>VIP-FTP.snat</name><alias-member-list><alias-member><address>VIP-FTP.1.snat</address></alias-member></alias-member-list></alias>
    <alias><name>VIP-RDP.snat</name><alias-member-list><alias-member><address>192.168.1.21</address></alias-member></alias-member-list></alias>
    <alias><name>TUNNEL-SECOND</name><alias-member-list><alias-member><address>Any</address><interface>SECOND</interface></alias-member></alias-member-list></alias>
