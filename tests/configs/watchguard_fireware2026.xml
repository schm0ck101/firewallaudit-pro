    <interface><name>LAN</name><if-property>1</if-property><if-item-list><item><physical-if><enabled>1</enabled><ip>192.168.1.1</ip><netmask>255.255.255.0</netmask></physical-if></item></if-item-list></interface>
    <interface><name>AGGR-LAN</name><if-property>1</if-property><if-item-list><item><physical-if><enabled>1</enabled><ip>0.0.0.0</ip><netmask>0.0.0.0</netmask></physical-if></item></if-item-list></interface>
