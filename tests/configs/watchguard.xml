<?xml version="1.0"?>
<profile>
  <for-version>12.8.3</for-version>
  <base-model>T40</base-model>
  <system-parameters><device-conf><system-name>FBX-CABINET</system-name></device-conf></system-parameters>
  <interface-list>
    <interface><name>External</name><if-property>External</if-property><if-item-list><item><physical-if><ip>203.0.113.30</ip><netmask>255.255.255.248</netmask><enabled>1</enabled></physical-if></item></if-item-list></interface>
    <interface><name>Trusted</name><if-property>Trusted</if-property><if-item-list><item><physical-if><ip>10.0.1.1</ip><netmask>255.255.255.0</netmask><enabled>1</enabled></physical-if></item></if-item-list></interface>
    <interface><name>Optional-1</name><if-property>Optional</if-property><if-item-list><item><physical-if><ip>10.0.2.1</ip><netmask>255.255.255.0</netmask><enabled>1</enabled></physical-if></item></if-item-list></interface>
  </interface-list>
  <address-group-list>
