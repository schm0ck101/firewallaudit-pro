    <address-group><name>Reseau-Trusted</name><addr-group-member><member><type>2</type><ip-network-addr>10.0.1.0</ip-network-addr><ip-mask>255.255.255.0</ip-mask></member></addr-group-member></address-group>
  </address-group-list>
  <alias-list>
    <alias><name>Any-Trusted</name><alias-member-list><alias-member><interface>Trusted</interface></alias-member></alias-member-list></alias>
    <alias><name>Any-External</name><alias-member-list><alias-member><interface>External</interface></alias-member></alias-member-list></alias>
    <alias><name>LAN-interne</name><alias-member-list><alias-member><address>Reseau-Trusted</address></alias-member></alias-member-list></alias>
  </alias-list>
  <service-list>
    <service><name>HTTPS</name><service-item><member><type>1</type><protocol>6</protocol><server-port>443</server-port></member></service-item></service>
    <service><name>Telnet</name><service-item><member><type>1</type><protocol>6</protocol><server-port>23</server-port></member></service-item></service>
    <service><name>Any</name><service-item><member><type>1</type><protocol>0</protocol><server-port>0</server-port></member></service-item></service>
    <service><name>Synology</name><service-item><member><type>1</type><protocol>6</protocol><start-server-port>5000</start-server-port><end-server-port>5001</end-server-port></member></service-item></service>
  </service-list>
