    <policy><name>Any</name><service>Any</service><firewall>1</firewall><enable>1</enable><log>0</log>
      <from-alias-list><alias>Any</alias></from-alias-list><to-alias-list><alias>Any</alias></to-alias-list></policy>
  </policy-list>
  <ike-policy-list><ike-policy><name>BOVPN-Agence</name><version>1</version><encryption-algorithm>DES</encryption-algorithm><authentication-algorithm>SHA1</authentication-algorithm><dh-group>1</dh-group></ike-policy></ike-policy-list>
